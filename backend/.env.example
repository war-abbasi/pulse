# Copy this file to .env and fill in real values.
#   cp .env.example .env

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/pulse-notifications
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/pulse-notifications?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/pulse-notifications

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# How long an issued token stays valid (zeit/ms format: 60s, 15m, 1d).
JWT_EXPIRES_IN=1d

# Port the NestJS server listens on. Hosting platforms usually set this
# themselves — leave it unset there.
PORT=3000

# Origins allowed to call this API. Comma-separated for more than one, e.g.
#   https://pulse.vercel.app,https://pulse-git-main-you.vercel.app
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the app, so req.ip is the real client
# rather than the proxy — the rate limiter depends on it.
#   0 = running directly (local development)
#   1 = behind one proxy (Render, Railway, Fly, most PaaS)
# Never set this higher than the real hop count: each trusted hop is one more
# X-Forwarded-For entry a client could forge to evade rate limiting.
TRUSTED_PROXY_HOPS=0
