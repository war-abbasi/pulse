# Copy this file to .env and fill in real values.
#   cp .env.example .env

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/pulse-notifications

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string

# How long an issued token stays valid (zeit/ms format: 60s, 15m, 1d).
JWT_EXPIRES_IN=1d

# Port the NestJS server listens on.
PORT=3000

# Origin allowed to call this API (the React dev server).
CORS_ORIGIN=http://localhost:5173
